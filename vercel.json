{
  "cleanUrls": true,
  "redirects": [{"source": "/de", "destination": "/de/", "permanent": true}, {"source": "/en", "destination": "/en/", "permanent": true}, {"source": "/zh", "destination": "/zh/", "permanent": true}],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Cache-Control", "value": "private, max-age=300" }
    ] }
  ]
}
